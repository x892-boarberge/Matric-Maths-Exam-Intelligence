def _declared_roots(text):
    """Extract every root the learner declared.

    Handles three forms:
        x = 5 or x = 3   -> {5, 3}
        x = 5 or 3       -> {5, 3}
        x = 5, 3         -> {5, 3}
    """
    if not isinstance(text, str):
        return set()
    out = set()

    # 1. Every "x = N" declaration
    for m in re.finditer(r"(?<![0-9a-z])x\s*=\s*(-?\d+(?:\.\d+)?)",
                         text, re.IGNORECASE):
        try:
            out.add(float(m.group(1)))
        except ValueError:
            pass

    # 2. Every bare number after "or", "and", or "," in a root-like
    #    context. Whitespace is optional — _norm collapses spaces
    #    around minus signs, so "or -2" becomes "or-2" before this
    #    runs.
    for m in re.finditer(r"\b(?:or|and|,)\s*(-?\d+(?:\.\d+)?)",
                         text, re.IGNORECASE):
        try:
            out.add(float(m.group(1)))
        except ValueError:
            pass

    return out


def diagnose(skill_id: str, learner_response: str, expected_answer: str,
             prompt: str = "") -> DiagnosisResult:
    nr = _norm(learner_response)

    if _is_correct(learner_response, expected_answer):
        return DiagnosisResult(
            error_type=ErrorType.NONE,
            misconception_id=None,
            confidence=1.0,
            rule_id="D_CORRECT",
            explanation="Response matches expected answer after normalisation.",
        )

    # Extra safety net: if the learner's declared roots equal the
    # expected roots as sets, treat the response as correct even when
    # the working text includes additional content that the matcher
    # cannot reduce. Prevents the N08 fallback from firing on noise.
    _lr = _declared_roots(learner_response)
    _er = _declared_roots(expected_answer)
    if _lr and _er and _lr == _er:
        # Exception 1: if the learner joined two roots with "and" instead
        # of "or", the roots match but the connector is wrong.
        _has_and_between_roots = bool(re.search(
            r"\d\s+and\s+[-x\d]",
            learner_response, re.IGNORECASE,
        ))
        # Exception 2: general-solution form mismatch. If either side
        # carries a general-solution marker (+ k.360, + 360k, k in Z)
        # and the other does not, the roots match but the form differs.
        # Do not short-circuit as "correct".
        _gen_re = r"\+\s*k\s*\.?\s*\d|\+\s*\d+\s*k|k\s*\u2208|k\s*in\s*Z"
        _learner_general = bool(re.search(_gen_re, learner_response, re.IGNORECASE))
        _expected_general = bool(re.search(_gen_re, expected_answer, re.IGNORECASE))
        _has_general_marker = _learner_general or _expected_general
        _has_fraction = "/" in str(learner_response) or "/" in str(expected_answer)
        _has_units = bool(re.search(r"\d\s*(?:cm|km|mm|kg|min|m|g|s|h|°|%|R|\$)\b", str(learner_response), re.IGNORECASE)) and not bool(re.search(r"\d\s*(?:cm|km|mm|kg|min|m|g|s|h|°|%|R|\$)\b", str(expected_answer), re.IGNORECASE))
        if (not _has_and_between_roots and not _has_general_marker 
            and not _has_fraction
            and not _has_units
            and not ("y=" in expected_answer.replace(" ","") or "y=" in nr.replace(" ",""))):
            return DiagnosisResult(
                error_type=ErrorType.NONE,
                misconception_id=None,
                confidence=0.95,
                rule_id="D_CORRECT_ROOTS_MATCH",
                explanation="Learner declared the same roots as expected, ignoring working text.",
            )

    for mid, etype, expl, pred in RULES.get(skill_id, []):
        try:
            fired = pred(nr, expected_answer, prompt)
        except TypeError:
            # Backwards-compatible: predicate only takes two arguments
            fired = pred(nr, expected_answer)
        if fired:
            return DiagnosisResult(
                error_type=etype,
                misconception_id=mid,
                confidence=0.85,
                rule_id=f"D_{mid}",
                explanation=expl,
            )

    # Layer 2 — trigger-based fallback (N08 v2)
    topic_hint = _topic_from_skill(skill_id)
    for rule in _load_trigger_library():
        if topic_hint and rule["topic"] not in (topic_hint, "GEN"):
            continue
        if rule["pattern"].search(nr):
            return DiagnosisResult(
                error_type=_error_type_for_class(rule["error_class"]),
                misconception_id=rule["mid"],
                confidence=0.65,
                rule_id=f"D_TRIGGER_{rule['mid']}",
                explanation=rule["description"],
            )

    return DiagnosisResult(
        error_type=ErrorType.UNKNOWN,
        misconception_id=None,
        confidence=0.3,
        rule_id="D_UNKNOWN",
        explanation="No matching correct or misconception pattern after normalisation.",
    )


def reachable_misconception_ids() -> set[str]:
    ids = set()
    for rules in RULES.values():
        for mid, *_ in rules:
            ids.add(mid)
    for rule in _load_trigger_library():
        ids.add(rule["mid"])
    return ids

