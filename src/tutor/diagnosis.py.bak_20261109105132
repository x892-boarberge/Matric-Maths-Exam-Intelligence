_TRIG_FUNCS = ("sin", "cos", "tan")


def _extract_trig_func(text):
    if not isinstance(text, str):
        return None
    for f in _TRIG_FUNCS:
        if re.search(r"\b" + f + r"\b", text, re.IGNORECASE):
            return f
    return None


def _trig_reduction_sign(nr, expected, prompt=""):
    """Learner lost the minus sign in a reduction."""
    if not isinstance(expected, str) or not isinstance(nr, str):
        return False
    e = expected.strip()
    if not e.startswith("-"):
        return False
    positive_form = e[1:].strip()
    if not positive_form:
        return False
    fn_e = _extract_trig_func(positive_form)
    fn_n = _extract_trig_func(nr)
    if fn_e and fn_n and fn_e == fn_n:
        return not re.search(r"-\s*" + fn_n, nr, re.IGNORECASE)
    return False


def _trig_reduction_cofunction(nr, expected, prompt=""):
    """Learner used the wrong co-function (sin<->cos)."""
    if not isinstance(expected, str) or not isinstance(nr, str):
        return False
    fn_e = _extract_trig_func(expected)
    fn_n = _extract_trig_func(nr)
    if not fn_e or not fn_n or fn_e == fn_n:
        return False
    return {fn_e, fn_n} == {"sin", "cos"}


def _trig_identity_linear(nr, expected, prompt=""):
    """sin 2x written as 2 sin x, or cos 2x written as 2 cos x."""
    if not isinstance(nr, str):
        return False
    low = nr.lower().replace(" ", "")
    return bool(re.search(r"sin2[a-z]?=2sin[a-z]\b", low)) or \
           bool(re.search(r"cos2[a-z]?=2cos[a-z]\b", low))


def _trig_eq_divide_by_ratio(nr, expected, prompt=""):
    """Divided both sides by a trig ratio, losing roots."""
    if not isinstance(nr, str):
        return False
    low = nr.lower().replace(" ", "")
    return bool(re.search(r"/(sin|cos|tan)[a-z]", low))


def _trig_eq_missing_solution(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    want = _declared_roots(expected)
    got = _declared_roots(nr)
    if not want or not got:
        return False
    return len(got) < len(want) and got.issubset(want)


def _trig_eq_general_when_interval(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(prompt, str):
        return False
    if "interval" not in prompt.lower() and "in the" not in prompt.lower():
        return False
    return bool(re.search(r"\+\s*k\s*\.?\s*360|\+\s*360k|k\s*\u2208", nr, re.IGNORECASE))


def _trig_period_domain_confusion(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    e = expected.strip()
    if not re.match(r"^\d+\s*\u00b0?$", e):
        return False
    return bool(re.search(r"\[|\]|\(|\)|\bin\b|\binterval\b", nr)) or "domain" in nr.lower()


def _trig_period_coefficient(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    try:
        e_val = float(re.sub(r"[^\d.]", "", expected))
    except Exception:
        return False
    m = re.search(r"\b(\d+)\s*\u00b0?\b", nr)
    if not m:
        return False
    got = float(m.group(1))
    return got != e_val and got in (180.0, 360.0)


def _trig_graph_value_label_swapped(nr, expected, prompt=""):
