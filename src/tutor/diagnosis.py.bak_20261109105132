def _proof_nonreal_explanation(nr, expected, prompt=""):
    if not isinstance(nr, str):
        return False
    low = nr.lower()
    if "discriminant" in low or "\u0394" in nr or "delta" in low:
        if not re.search(r"non-?real|no real roots|complex", low):
            return True
    return False

def _proof_integer_pattern(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(prompt, str):
        return False
    low_prompt = prompt.lower()
    if not ("even" in low_prompt or "odd" in low_prompt or "prove" in low_prompt):
        return False
    if len(nr.strip()) < 15:
        return False
    low = nr.lower()
    if re.search(r"even|odd|therefore|hence|\u2234|q\.e\.d|shown|conclude", low):
        return False
    return True



RuleFn = Callable[[str, str], bool]
RuleSpec = Tuple[str, ErrorType, str, RuleFn]

# skill_id -> ordered list of rules (first match wins)

def _robust_sign_flip(nr: str, expected: str) -> bool:
    """Detects if the learner got the right numbers but the wrong signs."""
    l_roots = _extract_roots(nr)
    e_roots = _extract_roots(expected)

    if len(l_roots) < 2 or len(l_roots) != len(e_roots):
        return False

    # Sort both lists to compare them
    l_roots.sort()
    e_roots.sort()

    # If they are exactly the same, it's not a sign flip (it's correct)
    if l_roots == e_roots:
        return False

    # Check if the absolute values match (ignoring signs)
    l_abs = sorted([abs(x) for x in l_roots])
    e_abs = sorted([abs(x) for x in e_roots])

    if l_abs == e_abs:
        return True

    return False

