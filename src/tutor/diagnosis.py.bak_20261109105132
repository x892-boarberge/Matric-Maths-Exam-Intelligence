def _surd_single_num_wrong(nr, expected, *args):
    """Surd question: learner wrote a single number/fraction that doesn't match."""
    import re as _r
    from fractions import Fraction

    def _parse(s):
        s = str(s).lower()
        s = _r.sub(r"\bx\s*=\s*", "", s)
        s = _r.sub(r"\by\s*=\s*", "", s)
        s = s.replace("=", "").strip()
        # Strip units (m, cm, kg, etc.) — they're presentation noise
        s = _r.sub(r"\d\s*(?:cm|km|mm|kg|min|m|g|s|h|°|%|R|\$)\b", "", s).strip()
        if _r.search(r"\bor\b|\band\b|,", s):
            return None
        try:
            return Fraction(s)
        except (ValueError, ZeroDivisionError, TypeError):
            try:
                return Fraction(float(s))
            except (ValueError, TypeError):
                return None

    l = _parse(nr)
    e = _parse(expected)
    return l is not None and e is not None and l != e

def _coord_sign_flip(nr, expected, *args):
    """Simultaneous: x = -3, y = 1 vs x = 3, y = 1 (some signs flipped)."""
    import re as _r
    def _pairs(s):
        s = str(s).lower().replace(" ", "")
        pairs = []
        current = {}
        for x_v, y_v in _r.findall(r"x=(-?\d+(?:\.\d+)?)|y=(-?\d+(?:\.\d+)?)", s):
            if x_v: current["x"] = float(x_v)
            if y_v:
                current["y"] = float(y_v)
                if "x" in current: pairs.append((current["x"], current["y"]))
                current = {}
        return pairs
    lp = _pairs(nr)
    ep = _pairs(expected)
    if not lp or not ep or len(lp) != len(ep):
        return False
    # Same absolute values but different signs
    l_abs = sorted([(abs(a), abs(b)) for a, b in lp])
    e_abs = sorted([(abs(a), abs(b)) for a, b in ep])
    return l_abs == e_abs and lp != ep


def _coord_missing_y(nr, expected, *args):
    """Simultaneous: learner wrote only x values, forgot y."""
