# DBE-audited predicates (conservative — better to miss than false-fire)
# ============================================================================

def _fn_inverse_always_log(nr, expected, *args):
    nrs = str(nr or "").lower()
    exps = str(expected or "").lower()
    if "log" not in nrs:
        return False
    if "log" in exps:
        return False
    # Expected is a non-log inverse: y=..., contains sqrt or x^ or a linear form
    return (("sqrt" in exps) or ("√" in exps) or ("^" in exps)
            or (exps.startswith("y =") and "x" in exps))


def _fn_asymptote_no_equation(nr, expected, *args):
    import re
    nrs = str(nr or "").strip()
    exps = str(expected or "").strip().lower()
    # Expected is exactly "x = N" or "y = N" (single number)
    if not re.match(r"^[xy]\s*=\s*-?\d+(\.\d+)?$", exps):
        return False
    # Learner wrote just a bare number
    return bool(re.match(r"^-?\d+(\.\d+)?$", nrs))


def _fn_log_notation_confusion(nr, expected, *args):
    # Both contain "log" but the base/argument ordering differs.
    # Conservative: only fire when both are single log expressions.
    import re
    nrs = str(nr or "").lower().replace(" ", "")
    exps = str(expected or "").lower().replace(" ", "")
    if "log" not in nrs or "log" not in exps:
        return False
    # Extract all numbers from each
    nums_l = re.findall(r"\d+(?:\.\d+)?", nrs)
    nums_e = re.findall(r"\d+(?:\.\d+)?", exps)
    if len(nums_l) < 2 or len(nums_e) < 2:
        return False
    # First two numbers swapped?
    return nums_l[0] == nums_e[1] and nums_l[1] == nums_e[0]


def _fn_inverse_restriction_ignored(nr, expected, *args):
    nrs = str(nr or "")
    exps = str(expected or "")
    return ("±" in nrs or "+/-" in nrs or "+ or -" in nrs) and "±" not in exps \
        and ("sqrt" in exps.lower() or "√" in exps)


def _fn_inverse_y_axis_reflection(nr, expected, *args):
    # Hard to detect from text alone. Conservative: skip (LLM fallback handles).
    return False


def _fn_log_of_negative(nr, expected, *args):
    import re
    nrs = str(nr or "").lower()
    return bool(re.search(r"log\s*_?[a-z0-9]*\s*\(\s*-\d", nrs))


def _fn_inverse_range_confusion(nr, expected, *args):
    # Learner used y-labels when x expected, or vice versa (with same numeric bound)
    import re
    nrs = str(nr or "").lower().replace(" ", "")
    exps = str(expected or "").lower().replace(" ", "")
    l_has_y = "y∈" in nrs or "y>" in nrs or "y<" in nrs or "y>=" in nrs or "y<=" in nrs
    l_has_x = "x∈" in nrs or "x>" in nrs or "x<" in nrs or "x>=" in nrs or "x<=" in nrs
    e_has_y = "y∈" in exps or "y>" in exps or "y<" in exps
    e_has_x = "x∈" in exps or "x>" in exps or "x<" in exps
    if not (e_has_x or e_has_y):
        return False
    # Labels flipped?
    if (e_has_x and l_has_y and not l_has_x):
        return True
    if (e_has_y and l_has_x and not l_has_y):
        return True
    return False


def _fn_inverse_base_exp_swap(nr, expected, *args):
    import re
    nrs = str(nr or "").lower().replace(" ", "")
    exps = str(expected or "").lower().replace(" ", "")
    # Expected looks like "y=b^x" pattern (base with variable exponent)
    exp_match = re.match(r"^y=(\d+)(?:\^|\*\*|_)?\(?([a-z])\)?$", exps)
    if not exp_match:
        return False
    base_e = exp_match.group(1)
    # Learner wrote "y=x^(1/base)" pattern
    learner_match = re.match(rf"^y=([a-z])\^?\(?1/{base_e}\)?$", nrs)
    return bool(learner_match)


def _fn_domain_inverse_confusion(nr, expected, *args):
    # Overlaps with range confusion but specific to domain context
    return False  # handled by M_INVERSE_RANGE_CONFUSION for now


def _fn_asymptote_wrong_form(nr, expected, *args):
    import re
    nrs = str(nr or "").lower().replace(" ", "")
    exps = str(expected or "").lower().replace(" ", "")
    # Error 1: "= q" or "= p" parameter confusion in learner
    if re.search(r"=[qpk]\b", nrs) and not re.search(r"=[qpk]\b", exps):
        return True
    # Error 2: learner wrote "x=k" when expected has "x!=k" (or reverse)
    if re.search(r"x=\d", nrs) and re.search(r"x≠\d|x!=\d", exps):
        return True
    return False


