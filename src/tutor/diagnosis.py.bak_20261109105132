# Predicates
def _fin_fv_pv_confusion(nr, expected, *args):
    # Learner wrote a formula-based answer that's the wrong direction (FV vs PV swapped)
    nrs = str(nr or "").lower()
    exps = str(expected or "").lower()
    # Heuristic: learner's value is dramatically different from expected (order of magnitude)
    import re
    l_nums = [float(x) for x in re.findall(r"\d+(?:\.\d+)?", nrs) if x]
    e_nums = [float(x) for x in re.findall(r"\d+(?:\.\d+)?", exps) if x]
    if not l_nums or not e_nums:
        return False
    l = l_nums[0]
    e = e_nums[0]
    if e == 0:
        return False
    ratio = l / e if l != 0 else 0
    # Ratio > 3 or < 0.33 suggests formula confusion, not arithmetic slip
    return (ratio > 3 or (ratio != 0 and ratio < 0.33))


def _fin_off_by_one(nr, expected, *args):
    # n differs by exactly 1 from expected
    import re
    nrs = str(nr or "")
    exps = str(expected or "")
    l_nums = [int(x) for x in re.findall(r"\b\d+\b", nrs)]
    e_nums = [int(x) for x in re.findall(r"\b\d+\b", exps)]
    if len(l_nums) != 1 or len(e_nums) != 1:
        return False
    return abs(l_nums[0] - e_nums[0]) == 1


def _fin_log_negative(nr, expected, *args):
    import re
    nrs = str(nr or "").lower()
    return bool(re.search(r"log\s*_?[a-z0-9]*\s*\(\s*-\d", nrs))


def _fin_round_up_months(nr, expected, *args):
    # Learner rounded DOWN to floor while expected is ceil (or vice versa)
    import re
    nrs = str(nr or "")
    exps = str(expected or "")
    l_nums = [float(x) for x in re.findall(r"\d+(?:\.\d+)?", nrs)]
    e_nums = [float(x) for x in re.findall(r"\d+(?:\.\d+)?", exps)]
    if not l_nums or not e_nums:
        return False
    import math
    return (abs(l_nums[0] - math.floor(e_nums[0])) < 0.01 and
            abs(e_nums[0] - math.floor(e_nums[0])) > 0.01)


