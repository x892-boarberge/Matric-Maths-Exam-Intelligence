        return False
    return bool(re.search(r"\by\s*=", nr)) and not re.search(r"\bx\s*=", nr)


def _trig_compound_wrong_form(nr, expected, prompt=""):
    """Learner used cos-expansion where sin-expansion was needed.

    Both sin(A+B) and cos(A-B) contain two sin and two cos terms, so
    counting does not work. Detect the first product pattern instead.
    """
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    low_e = expected.lower().replace(" ", "")
    low_n = nr.lower().replace(" ", "")
    # Expected pattern: sin*cos + cos*sin
    e_sin_first = bool(re.search(r"sin[abc]?\*?cos[abc]?", low_e))
    # Learner pattern: cos*cos +/- sin*sin (the cos-expansion)
    n_cos_first = bool(re.search(r"cos[abc]?\*?cos[abc]?", low_n))
    if e_sin_first and n_cos_first:
        return True
    return False


def _trig_3d_wrong_ratio(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    fn_e = _extract_trig_func(expected)
    fn_n = _extract_trig_func(nr)
    if not fn_e or not fn_n:
        return False
    return fn_e != fn_n and {fn_e, fn_n}.issubset({"sin", "cos", "tan"})


def _trig_unitcircle_sign(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    def _nums(s):
        return re.findall(r"-?\d+(?:\.\d+)?", s)
    e_nums = _nums(expected)
    n_nums = _nums(nr)
    if not e_nums or not n_nums:
        return False
    try:
        e_mag = {abs(float(x)) for x in e_nums}
        n_mag = {abs(float(x)) for x in n_nums}
        e_signed = {float(x) for x in e_nums}
        n_signed = {float(x) for x in n_nums}
    except ValueError:
        return False
    if e_mag != n_mag:
        return False
    return e_signed != n_signed


def _trig_max_angle_not_ratio(nr, expected, prompt=""):
    if not isinstance(nr, str):
        return False
    if re.search(r"\bx\s*=\s*-?\d+\s*\u00b0?", nr):
        if not re.search(r"\b(sin|cos|tan)\s*[a-z]?\s*=", nr, re.IGNORECASE):
            return True
    return False


def _looks_like_general_solution(text):
    """True if the text expresses a periodic/general solution.

    Covers SA-matric notation:
      + 360k   + 360 k   + k·360   + k.360   + 2kπ   + kπ
      + 180n   + n·180   + 2nπ    + k*360
    """
    if not text:
        return False
    t = str(text).lower()
    t = t.replace("\u00b0", "").replace("\u00b7", ".").replace("\u03c0", "pi")
    # remove the "or" separator to avoid false hits on words
    patterns = [
        r"[+\-]\s*\d*\s*[kn]\b",                    # + 360k, + k, + 2n
        r"[+\-]\s*[kn]\s*\.?\s*\d+",               # + k.360, + n.180
        r"[+\-]\s*\d*\s*[kn]\s*pi",                 # + 2kpi, + kpi
        r"\b[kn]\s*\.?\s*\d+\s*(?:pi)?",             # k.360, n.180
    ]
    for p in patterns:
        if re.search(p, t):
            return True
    return False


def _trig_general_solution_incomplete(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    if not _looks_like_general_solution(expected):
        return False
    return not _looks_like_general_solution(nr)


