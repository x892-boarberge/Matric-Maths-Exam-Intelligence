# Predicates
def _calc_tp_no_y(nr, expected, *args):
    import re
    nrs = str(nr or "").strip()
    exps = str(expected or "").strip()
    # Expected is coordinate pair like "(5; -36)"
    if "(" not in exps or ";" not in exps:
        return False
    # Learner just gave a number or x= value
    if re.match(r"^-?\d+(?:\.\d+)?$", nrs):
        return True
    if re.match(r"^x\s*=\s*-?\d+", nrs.lower()):
        return True
    return False


def _calc_concavity_sign(nr, expected, *args):
    import re
    nrs = str(nr or "").lower().replace(" ", "")
    exps = str(expected or "").lower().replace(" ", "")
    # Both are inequalities with the same boundary but opposite direction
    l_match = re.match(r"^x([<>])(-?\d+(?:\.\d+)?)$", nrs)
    e_match = re.match(r"^x([<>])(-?\d+(?:\.\d+)?)$", exps)
    if not (l_match and e_match):
        return False
    return l_match.group(2) == e_match.group(2) and l_match.group(1) != e_match.group(1)


def _calc_tangent_range(nr, expected, *args):
    import re
    nrs = str(nr or "")
    exps = str(expected or "")
    # Expected contains a range (has < and < with two numbers)
    if not (exps.count("<") >= 2 or exps.count("≤") >= 2 or ("<" in exps and "and" in exps.lower())):
        return False
    # Learner gave a single value (no range operators)
    if "<" not in nrs and "≤" not in nrs:
        return True
    return False
