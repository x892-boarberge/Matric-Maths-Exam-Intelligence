"""
Presentation matcher v2.

Behaviour-based, not answer-shape-based.

Every presentation rule fires whenever its named behaviour is present in the
learner's working. Two tiers of note:

  generic - behaviour present. DBE flags this pattern across the corpus.
            No penalty claim. Always fires.

  special - behaviour present AND the memo step scheme for this specific
            question awarded a mark for the step the learner skipped.
            Reports the lost mark.

No per-sitting suppression. Every occurrence is reported.

Public:
    check_presentation(working_lines, topic=None, step_result=None)
        -> list[PresentationNote]
    format_note(note) -> str
"""
from __future__ import annotations

import csv
import re
from dataclasses import dataclass
from pathlib import Path
from typing import List, Optional


ROOT = Path(__file__).resolve().parents[2]
CSV_PATH = ROOT / "data" / "processed" / "tutor" / "presentation_rules_v1.csv"

PRIORITY_RANK = {"critical": 4, "high": 3, "medium": 2, "low": 1}


@dataclass
class PresentationNote:
    rule_id: str
    behaviour: str            # what the learner did
    dbe_pattern: str          # what DBE reports seeing across years
    advice: str               # what to do differently
    priority: str = "medium"
    tier: str = "generic"     # "generic" | "special"
    penalty: int = 0          # marks lost (only set when tier="special")
    evidence: str = ""        # the specific line that triggered the note


# ==================================================================
# Rules table
# ==================================================================
def _load_rules() -> List[dict]:
    if not CSV_PATH.exists():
        return []
    with CSV_PATH.open(encoding="utf-8", newline="") as f:
        return list(csv.DictReader(f))


_RULES: Optional[List[dict]] = None


def _rules() -> List[dict]:
    global _RULES
    if _RULES is None:
        _RULES = _load_rules()
    return _RULES


# ==================================================================
# Behaviour predicates
#
# Each predicate reports whether the SPECIFIC behaviour is present.
# Not the answer shape. Not a proxy. The behaviour itself.
# Return: the evidence line, or None.
# ==================================================================

def _find_line(text: str, pred) -> Optional[str]:
    for line in text.splitlines():
        if pred(line):
            return line.strip()
    return None


# -- PR_GEN_001: final answer buried in working, not on its own line --
def _p_answer_buried(text: str) -> Optional[str]:
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    if len(lines) < 2:
        return None
    last = lines[-1]
    # A short final line with "=" is fine. A long line with working is not.
    if "=" in last and len(last) < 40:
        return None
    if "=" in last or re.search(r"\bx\s*=", last):
        return last
    return None


# -- PR_GEN_004 / PR_DBE_010: multiple "=" on one line --
def _p_multi_equals(text: str) -> Optional[str]:
    return _find_line(text, lambda l: l.count("=") >= 3)


# -- PR_GEN_005: crossing-out symbols typed into the answer --
def _p_crossout_symbols(text: str) -> Optional[str]:
    if "!!!" in text or "~~" in text:
        return "(crossing-out symbols in answer)"
    return None


# -- PR_GEN_009: substitution step skipped --
def _p_skipped_substitution(text: str, topic: Optional[str]) -> Optional[str]:
    """A single-line answer that jumps from formula to a final number,
    with no intermediate substitution. This is the behaviour; the
    question does not have to require substitution for the trigger to
    fire. The special tier is decided later by the memo."""
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    if len(lines) != 1:
        return None
    line = lines[0]
    # Only fire when the line reads as a computed value with no formula
    if re.search(r"=\s*-?\d+(\.\d+)?\s*$", line) and "(" not in line and "^" not in line:
        return line
    return None


# -- PR_GEN_011: units missing when the topic needs them --
def _p_missing_units(text: str, topic: Optional[str]) -> Optional[str]:
    if topic not in ("FIN", "CALC", "AGEO", "TRIG"):
        return None
    if re.search(r"\bcm\b|\bm\b|\bkm\b|\bR\s*\d|\bdegrees\b|deg|\u00b0|\bm\u00b2|\bcm\u00b2|\bcm\u00b3", text):
        return None
    for line in text.splitlines():
        if re.search(r"=\s*-?\d+(\.\d+)?\s*$", line):
            return line.strip()
    return None


# -- PR_GEN_014 / PR_DBE_005: only one root given for a quadratic --
def _p_single_root(text: str, topic: Optional[str]) -> Optional[str]:
    roots = re.findall(r"x\s*=\s*-?\d+(?:\.\d+)?", text)
    if len(roots) == 1:
        return roots[0]
    return None


# -- PR_ALG_012: sqrt equation solved without rejecting extraneous root --
def _p_no_reject(text: str) -> Optional[str]:
    if "sqrt" not in text.lower() and "\u221a" not in text:
        return None
    if "reject" in text.lower() or "extraneous" in text.lower():
        return None
    return "(sqrt equation solved without reject check)"


# -- PR_ALG_016 / PR_DBE_004: negative number without brackets --
def _p_negative_no_brackets(text: str) -> Optional[str]:
    m = re.search(r"[+\-]\s*-\s*\d", text)
    if m:
        return text[max(0, m.start()-10):m.end()+10]
    return None


# -- PR_DIAG_008: assumption from diagram --
def _p_diagram_assumption(text: str) -> Optional[str]:
    low = text.lower()
    if "assum" in low and "because" in low:
        return _find_line(text, lambda l: "assum" in l.lower())
    return None


# -- PR_EUCL_001: no reason column in Euclidean proof --
def _p_no_reason_column(text: str, topic: Optional[str]) -> Optional[str]:
    if topic != "EUCL":
        return None
    reason_words = ["reason", "angle", "sides", "cyclic", "semicircle",
                    "tangent", "chord", "radius", "diameter", "opposite"]
    low = text.lower()
    if not any(w in low for w in reason_words):
        return "(no reason given for any statement)"
    return None


# -- PR_FIN_009: monetary answer without R prefix --
def _p_no_currency(text: str, topic: Optional[str]) -> Optional[str]:
    if topic != "FIN":
        return None
    if "R" in text:
        return None
    m = re.search(r"\d+\.\d+", text)
    if m:
        return m.group(0)
    return None


# -- PR_STAT_012: median without stating position --
def _p_median_no_position(text: str) -> Optional[str]:
    low = text.lower()
    if "median" in low and "position" not in low:
        return _find_line(text, lambda l: "median" in l.lower())
    return None


# -- PR_PROB_014: probability > 1 --
def _p_prob_over_one(text: str, topic: Optional[str]) -> Optional[str]:
    if topic != "PROB":
        return None
    m = re.search(r"\b([2-9]\.\d+)\b", text)
    if m:
        return m.group(0)
    return None


# ==================================================================
# Registry
# ==================================================================
_RULE_PREDICATES = {
    "PR_GEN_001":   lambda t, top: _p_answer_buried(t),
    "PR_GEN_004":   lambda t, top: _p_multi_equals(t),
    "PR_GEN_005":   lambda t, top: _p_crossout_symbols(t),
    "PR_GEN_009":   lambda t, top: _p_skipped_substitution(t, top),
    "PR_GEN_011":   lambda t, top: _p_missing_units(t, top),
    "PR_GEN_014":   lambda t, top: _p_single_root(t, top),
    "PR_ALG_012":   lambda t, top: _p_no_reject(t),
    "PR_ALG_016":   lambda t, top: _p_negative_no_brackets(t),
    "PR_DIAG_008":  lambda t, top: _p_diagram_assumption(t),
    "PR_EUCL_001":  lambda t, top: _p_no_reason_column(t, top),
    "PR_FIN_009":   lambda t, top: _p_no_currency(t, top),
    "PR_STAT_012":  lambda t, top: _p_median_no_position(t),
    "PR_PROB_014":  lambda t, top: _p_prob_over_one(t, top),
    "PR_DBE_004":   lambda t, top: _p_negative_no_brackets(t),
    "PR_DBE_005":   lambda t, top: _p_single_root(t, top),
    "PR_DBE_010":   lambda t, top: _p_multi_equals(t),
}


# ==================================================================
# Penalty detection
#
# A rule's note is elevated to "special" when the memo step scheme for
# this question has a NOT_MATCHED or UNCERTAIN step whose description
# matches the rule's behaviour. That is the memo telling us a mark was
# awarded for the exact step the learner skipped.
# ==================================================================
_RULE_TO_STEP_KEYWORDS = {
    "PR_GEN_009":  ["substitut"],
    "PR_ALG_012":  ["reject", "extraneous"],
    "PR_GEN_014":  ["root"],
    "PR_DBE_005":  ["root"],
    "PR_ALG_016":  ["simplif", "sign"],
    "PR_DBE_004":  ["simplif", "sign"],
    "PR_FIN_009":  ["answer", "amount"],
    "PR_STAT_012": ["median", "position"],
}


def _check_penalty(rule_id: str, step_result: Optional[dict]) -> int:
    """Return marks lost if the memo for this question penalised this
    rule's behaviour. Returns 0 if no penalty or no step_result."""
    if not step_result:
        return 0
    keywords = _RULE_TO_STEP_KEYWORDS.get(rule_id, [])
    if not keywords:
        return 0
    lost = 0
    for step in step_result.get("steps", []):
        status = step.get("match_status")
        if status not in ("NOT_MATCHED", "UNCERTAIN"):
            continue
        desc = (step.get("desc") or "").lower()
        if any(kw in desc for kw in keywords):
            lost += int(step.get("marks", 1))
    return lost


# ==================================================================
# Main check
# ==================================================================
def check_presentation(working_lines, topic=None, step_result=None,
                       max_notes=None):
    """
    Return every presentation note whose behaviour is present.

    Notes are not suppressed or capped. max_notes is accepted for
    backward compatibility but ignored.

    step_result (from step_grader) is optional. When provided, any
    rule whose behaviour maps to a skipped memo step is elevated to
    tier="special" and reports the marks lost.
    """
    if isinstance(working_lines, list):
        text = "\n".join(str(l) for l in working_lines)
    else:
        text = str(working_lines or "")

    if not text.strip():
        return []

    notes: List[PresentationNote] = []
    seen_rule_ids = set()

    # Wired rules: behaviour predicates
    for rule in _rules():
        rid = rule.get("rule_id", "")
        pred = _RULE_PREDICATES.get(rid)
        if pred is None:
            continue
        if rid in seen_rule_ids:
            continue
        try:
            evidence = pred(text, topic)
        except Exception:
            evidence = None
        if evidence is None:
            continue
        seen_rule_ids.add(rid)

        penalty = _check_penalty(rid, step_result)
        notes.append(PresentationNote(
            rule_id=rid,
            behaviour=(rule.get("advice") or "").strip(),
            dbe_pattern=(rule.get("dbe_note") or "").strip(),
            advice=(rule.get("advice") or "").strip(),
            priority=(rule.get("priority") or "medium").strip(),
            tier="special" if penalty > 0 else "generic",
            penalty=penalty,
            evidence=str(evidence)[:120],
        ))

    # Unwired rules: keyword-overlap fallback against the trigger column
    for rule in _rules():
        rid = rule.get("rule_id", "")
        if rid in _RULE_PREDICATES or rid in seen_rule_ids:
            continue
        rule_topic = rule.get("topic")
        if rule_topic not in (topic, "all", "", None):
            continue
        trig = (rule.get("trigger") or "").lower()
        words = [w for w in re.findall(r"[a-z]{4,}", trig) if len(w) > 3]
        if not words:
            continue
        low = text.lower()
        hits = sum(1 for w in words if w in low)
        if hits < 3:
            continue
        seen_rule_ids.add(rid)
        notes.append(PresentationNote(
            rule_id=rid,
            behaviour=(rule.get("advice") or "").strip(),
            dbe_pattern=(rule.get("dbe_note") or "").strip(),
            advice=(rule.get("advice") or "").strip(),
            priority=(rule.get("priority") or "medium").strip(),
            tier="generic",
        ))

    # Sort: special first, then by priority
    notes.sort(key=lambda n: (
        -1 if n.tier == "special" else 0,
        -PRIORITY_RANK.get(n.priority, 0),
    ))
    return notes


# ==================================================================
# Rendering
# ==================================================================
def format_note(note: PresentationNote) -> str:
    """Render one note. Two visual registers."""
    lines = []
    if note.tier == "special":
        lines.append("")
        lines.append("  \u26a0 Mark lost \u2014 " +
                     (note.behaviour or "step skipped"))
        if note.penalty:
            word = "mark" if note.penalty == 1 else "marks"
            lines.append(f"  The memo awarded {note.penalty} {word} for this step.")
        if note.advice:
            lines.append(f"  What to do: {note.advice}")
        if note.evidence:
            lines.append(f"  You wrote: {note.evidence}")
        lines.append(f"  ({note.rule_id})")
    else:
        lines.append("")
        lines.append("  ~ Presentation note ~")
        if note.dbe_pattern:
            lines.append(f"  {note.dbe_pattern}")
        if note.advice:
            lines.append(f"  Rule: {note.advice}")
        lines.append(f"  ({note.rule_id} | priority: {note.priority})")
    return "\n".join(lines)
