                    _var_text = " ".join(_var_lines)

                    from src.tutor.math_grader import grade as _vg
                    _gv = _vg(_var_text, _var["expected"])

                    # Diagnose FIRST so evidence and misconception_id are correct
                    from src.tutor.diagnosis import diagnose as _vd_pre
                    try:
                        _dv_pre = _vd_pre(problem.skill_id, _var_text, _var["expected"])
                        _mid_pre = _dv_pre.misconception_id
                    except Exception:
                        _mid_pre = None

                    try:
                        _var_evidence = {
                            "version": 1,
                            "raw": {
                                "question_id": "VAR_Q" + _sub_id,
                                "skill_id": problem.skill_id,
                                "learner_lines": list(_var_lines),
                                "final_answer": _var_lines[-1] if _var_lines else "",
                                "line_count": len(_var_lines),
                                "is_variant": True,
                                "source_question": problem.problem_id,
