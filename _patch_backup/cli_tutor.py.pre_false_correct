def _show_dependencies(problem, store, learner_id):
    """Flip back through every prior subquestion of this question.

    For each prior subquestion, show:
      - the number and prompt (from the template)
      - every line the learner wrote (from evidence_json.raw.learner_lines)
      - the diagnosis if there was one (misconception_id)
      - the learner-facing message from the objective (if any)
      - the mark (from evidence_json.interpretation and step_scheme, if present)

    Returns True to continue, False to go back.
    """
    import json as _j
    try:
        from src.tutor.question_loader import (
            subquestion_info, load_template_for,
        )
        from src.tutor import teaching_objectives as _to
        info = subquestion_info(problem.problem_id)
    except Exception:
        return True
    if not info:
        return True

    given = info.get("given_from") or []
    _skills_raw = info.get("requires_skills") or []
    if not given and not _skills_raw:
        return True

    # Load the parent template so we can read each prior subquestion's
    # prompt text.
    tpl = load_template_for(problem.problem_id)
    prev_by_n = {}
    if tpl:
        for sq in tpl.get("subquestions", []):
            n = str(sq.get("n", "")).strip()
            if n:
                prev_by_n[n] = sq

    stem_parts = problem.problem_id.split("_")
    stem_prefix = stem_parts[0] + "_" + stem_parts[1] + "_Q"

    print()
    print("  ── flipping back through your work on this question ──")
    print()

    any_missing = False

    for prev_n in given:
        prev_id = stem_prefix + str(prev_n)
        sq = prev_by_n.get(str(prev_n), {})
        prompt_text = sq.get("prompt_template") or "(question text not available)"

        print(f"  {prev_n}  {prompt_text}")

        try:
            row = store.conn.execute(
                "SELECT response, error_type, misconception_id, "
                "       evidence_json "
                "FROM attempt "
                "WHERE learner_id = ? AND question_id = ? "
                "ORDER BY timestamp DESC LIMIT 1",
                (learner_id, prev_id),
            ).fetchone()
        except Exception:
            row = None

        if row is None:
            any_missing = True
            print(f"      (you have not attempted this)")
            print()
            continue

        # Full line-by-line working from evidence_json
        lines = []
        try:
            ev = _j.loads(row["evidence_json"]) if row["evidence_json"] else {}
            raw = ev.get("raw") or {}
            lines = raw.get("learner_lines") or []
        except Exception:
            lines = []
        if not lines and row["response"]:
            lines = [row["response"]]

        for i, ln in enumerate(lines, 1):
            print(f"      Line {i}:  {ln}")

        # Diagnosis and message
        mid = row["misconception_id"]
        if mid:
            print(f"      Noticed: {mid}")
            try:
                obj = _to.find_for(mid)
                if obj and obj.get("learner_message"):
                    print(f"      Tanaka:  {obj['learner_message']}")
            except Exception:
                pass

        # Result line — tell the learner the outcome, not the code word.
        err = (row["error_type"] or "").strip()
        if err == "none":
            print(f"      Result:  correct")
        elif mid:
            # A specific misconception was identified — the learner was
            # already told what it was in the Tanaka line above.
            print(f"      Result:  not correct")
        else:
            print(f"      Result:  not correct — the tutor did not "
                  f"recognise this one")

        print()

    # NEW: cross-section skill prerequisites (requires_skills).
    _skills = []
    for _s in _skills_raw:
        if isinstance(_s, str) and _s.strip():
            _skills.append(_s.strip())
        elif isinstance(_s, dict):
            _sid = (_s.get("skill_id") or _s.get("id") or "").strip()
            if _sid:
                _skills.append(_sid)

    _prev_ids = {stem_prefix + str(n) for n in given}
    _skill_missing = []

    for _sid in _skills:
        if _sid == problem.skill_id:
            continue
        try:
            _srow = store.conn.execute(
                "SELECT response, error_type, misconception_id, "
                "       evidence_json, question_id "
                "FROM attempt "
                "WHERE learner_id = ? AND skill_id = ? "
                "ORDER BY timestamp DESC LIMIT 1",
                (learner_id, _sid),
            ).fetchone()
        except Exception:
            _srow = None
        if _srow is None:
            _skill_missing.append(_sid)
            continue
        if _srow["question_id"] in _prev_ids:
            continue
        print(f"  {_sid}  [earlier attempt on {_srow['question_id']}]")
        _slines = []
        try:
            _sev = _j.loads(_srow["evidence_json"]) if _srow["evidence_json"] else {}
            _sraw = _sev.get("raw") or {}
            _slines = _sraw.get("learner_lines") or []
        except Exception:
            _slines = []
        if not _slines and _srow["response"]:
            _slines = [_srow["response"]]
        for _i, _ln in enumerate(_slines, 1):
            print(f"      Line {_i}:  {_ln}")
        _smid = _srow["misconception_id"]
        if _smid:
            print(f"      Noticed: {_smid}")
            try:
                _sobj = _to.find_for(_smid)
                if _sobj and _sobj.get("learner_message"):
                    print(f"      Tanaka:  {_sobj['learner_message']}")
            except Exception:
                pass
        _serr = (_srow["error_type"] or "").strip()
        if _serr == "none":
            print(f"      Result:  correct")
        elif _smid:
            print(f"      Result:  not correct")
        else:
            print(f"      Result:  not correct — the tutor did not recognise this one")
        print()

    if _skill_missing:
        any_missing = True
        _shown = ", ".join(_skill_missing[:3])
        _suffix = f" (+{len(_skill_missing)-3} more)" if len(_skill_missing) > 3 else ""
        print(f"  No earlier work on: {_shown}{_suffix}")
        print()

    print("  ──────────────────────────────────────────────────────────")
    if any_missing:
        print("  Some earlier parts have not been attempted.")
        print("  The question can still be done if the given values are")
        print("  clear from the paper.")
        print()
        choice = input("  Try now, or go back? [t/b]: ").strip().lower()
        if choice in ("b", "back", "no", "n"):
            return False
    else:
        print("  All earlier parts have been attempted.")
    print()

    return True

def _marks_for_subquestion(problem):
    """Best-effort marks for a subquestion from the CSV. Returns int or None."""
    import csv as _csv
    parts = problem.problem_id.split("_")
    if len(parts) < 3:
        return None
    year, paper = parts[0], parts[1]
    qsub = parts[2]
    qnum = qsub[1:].split(".")[0]
    subq_id = qsub[1:]
    csv_path = ROOT / "data" / "processed" / "mapped" / year / ("question_topic_map_" + year + "_v2.csv")
    if not csv_path.exists():
        return None
    try:
        with open(csv_path, encoding="utf-8", errors="ignore") as f:
            for r in _csv.DictReader(f):
                rp = (r.get("paper") or "").strip()
                rq = (r.get("question_number") or "").strip().split(".")[0]
                rs = (r.get("subquestion") or "").strip()
                if rp == paper and rq == qnum and rs == subq_id:
                    m = (r.get("marks") or "").strip()
                    if m:
                        try:
                            return int(float(m))
                        except ValueError:
                            pass
    except Exception:
        pass
    return None


def _subq_sort_key(p):
    parts = p.problem_id.split("_")
    if len(parts) < 3:
        return (999,)
    nums = parts[2][1:].split(".")
    key = []
    for x in nums:
        try:
            key.append(int(x))
        except ValueError:
            key.append(0)
    return tuple(key)


def _build_groups(problems):
    from collections import defaultdict
    groups = defaultdict(list)
    for prob in problems:
        parts = prob.problem_id.split("_")
        if len(parts) < 3:
            continue
        year, paper, qsub = parts[0], parts[1], parts[2]
        qnum = qsub[1:].split(".")[0]
        groups[(year, paper, qnum)].append(prob)
    for k in list(groups.keys()):
        groups[k] = sorted(groups[k], key=_subq_sort_key)
    return groups


def _pick_paper_question(problems):
    """Paper -> Year -> Question list."""
    groups = _build_groups(problems)

    while True:
        print()
        print("=" * 60)
        print("Practice Problem")
        print("=" * 60)
        print("  1. Paper 1")
        print("  2. Paper 2")
        print("  B. Back")
        print("=" * 60)
        choice = input("Choose [1-2, B]: ").strip().upper()
        if choice == "B":
            return None
        if choice not in ("1", "2"):
            continue
        paper_label = "P" + choice

        years = sorted(set(k[0] for k in groups if k[1] == paper_label), reverse=True)
        if not years:
            print("No questions found for this paper.")
            continue

        print()
        print("Paper " + choice + " — Choose a Year")
        print("=" * 60)
        for i, y in enumerate(years, 1):
            print("  " + str(i) + ". " + y)
        print("  B. Back")
        print("=" * 60)
        ychoice = input("Choose [1-" + str(len(years)) + ", B]: ").strip().upper()
        if ychoice == "B":
            continue
        if not ychoice.isdigit() or not (1 <= int(ychoice) <= len(years)):
            continue
        year = years[int(ychoice) - 1]

        q_keys = [k for k in groups if k[0] == year and k[1] == paper_label]
        def q_num(k):
            try:
                return int(k[2])
            except ValueError:
                return 99
        q_keys.sort(key=q_num)

        print()
        print(year + " Paper " + choice + " — Questions")
        print("=" * 60)
        for i, k in enumerate(q_keys, 1):
            g = groups[k]
            topic_label = g[0].topic if g else "???"
            print("  " + str(i).rjust(2) + ". Q" + k[2].ljust(3) + "  (" + topic_label + ") - " + str(len(g)) + " subquestions")
        print("  B. Back")
        print("=" * 60)
        qchoice = input("Choose [1-" + str(len(q_keys)) + ", B]: ").strip().upper()
        if qchoice == "B":
            continue
        if not qchoice.isdigit() or not (1 <= int(qchoice) <= len(q_keys)):
            continue
        return groups[q_keys[int(qchoice) - 1]]


def _run_whole_question(engine, store, learner_id, session_id, group, logger):
    """Present the question as an answer book."""
    if not group:
        return
    parts = group[0].problem_id.split("_")
    year, paper, qpart = parts[0], parts[1], parts[2]
    qnum = qpart[1:].split(".")[0]
    diagram_path = _diagram_path_for(group[0])

    print()
    print("=" * 60)
    print("  " + year + "  Paper " + paper[1] + "  Question " + qnum)
    print("  Answer Book")
    if diagram_path:
        print("  Paper image: " + str(diagram_path))
        _open_diagram(group[0])
        print("  (opened in your viewer — the paper stays open)")
    else:
        print("  (no paper image for this question)")
    print("=" * 60)

    _i = 0
    _variant_practice_this_subq = False
    while _i < len(group):
        subq = group[_i]
        marks = _marks_for_subquestion(subq)
        marks_label = "[" + str(marks) + "]" if marks else "[?]"
        sub_id = subq.problem_id.split("_")[-1]

        print()
        print("-" * 60)
        print("  " + sub_id)
        print()
        if subq.prompt and subq.prompt != "(question text not available)":
            print("  (Paper reads: " + subq.prompt[:70] + ")")
            print()
        print("  ... write your working below ... (type 'done' to finish)")
        print()
        print("  " + " " * 50 + marks_label)
        print("-" * 60)

        try:
            keep_going = _run_single_anchor(engine, store, learner_id, session_id,
                               subq, logger,
                               skip_diagram=True, skip_dependencies=True,
                               variant_practice_done=_variant_practice_this_subq)

            if keep_going == "QUIT":
                break
            elif keep_going == "MENU":
                return "MENU"
            elif keep_going == "RETRY":
                _variant_practice_this_subq = True  # Persist across retries
                continue
            else:
                _i += 1  # Move to next subquestion
                _variant_practice_this_subq = False  # Reset for next subq
        except Exception as e:
            print("  [error on subquestion " + sub_id + ": " + str(e) + "]")
            _i += 1

    print()
    print("=" * 60)
    print("  Question " + qnum + " complete.")
    print("=" * 60)
    try:
        _skill = group[0].skill_id if group else ""
        show_session_summary(store, learner_id, session_id, _skill, [])
        show_learner_dashboard(store, learner_id)
    except Exception as _e:
        print(f"  [dashboard unavailable: {_e}]")


