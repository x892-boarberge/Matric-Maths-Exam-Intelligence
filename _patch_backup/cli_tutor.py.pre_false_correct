                            print("  better to rest than to burn out. I've saved a note that you")
                            print("  struggled with this shape, so we can pick it up fresh next time.")
                            print("  " + "=" * 56)
                            store.log_event(
                                learner_id, problem.skill_id, problem.problem_id,
                                "QUIT_AFTER_VARIANTS",
                                "Quit after " + str(_variant_attempts) + " variants",
                                session_id
                            )
                            print()
                            print("  Where to next?")
                            print("    1. Back to original question")
                            print("    2. Next subquestion")
                            print("    3. Question list")
                            print("    4. End session")
                            _nav = input("  > ").strip()
                            if _nav == "1":
