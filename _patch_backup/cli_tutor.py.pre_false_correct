                            import re as _re
                            l_nums = [float(n) for n in _re.findall(r"[-+]?\d*\.?\d+", _var_text) if n not in ('', '-', '+')]
                            e_nums = [float(n) for n in _re.findall(r"[-+]?\d*\.?\d+", _var["expected"]) if n not in ('', '-', '+')]

