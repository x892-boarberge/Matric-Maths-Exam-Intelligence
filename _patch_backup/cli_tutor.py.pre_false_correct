def _show_playbook_if_available(problem):
    """Loads the exact question playbook and prints the tutor's variant."""
    import json, re
    from pathlib import Path

    parts = problem.problem_id.split("_")
    if len(parts) < 3: return False
    parent_id = f"{parts[0]}_{parts[1]}_{parts[2].split('.')[0]}"
    subq_id = parts[2][1:]

    playbook_file = Path(__file__).resolve().parents[1] / "data" / "processed" / "tutor" / "playbooks" / f"{parent_id}.json"
    if not playbook_file.exists():
        return False

    try:
        data = json.loads(playbook_file.read_text(encoding="utf-8"))
        entry = data.get("subquestions", {}).get(subq_id)
        if not entry:
            return False

        print()
        print("=" * 60)
        print("  Let's look at a similar problem together.")
        print("=" * 60)

        if entry.get("variant_question"):
            print(f"\n  Example: {entry['variant_question']}\n")

        if entry.get("memo_steps"):
            print("  Worked Solution:")
            for line in entry["memo_steps"]:
                print(f"            {line}")
            print()

        print("  🎯 THE INSTRUCTION:")
        for line in entry["hack"].split("\n"):
            print("     " + line)

        print("\n  ⚠️  THE TRAP:")
        for line in entry["trap"].split("\n"):
            print("     " + line)

        print("\n  ✅ PRESENTATION (Memo Rule):")
        for line in entry["presentation"].split("\n"):
            print("     " + line)

        print("=" * 60)
        print()
        return True
    except Exception as e:
        print(f"  [Playbook Error: {e}]")
        return False

def _run_single_anchor(engine, store, learner_id, session_id, problem, logger,
                       skip_diagram=False, skip_dependencies=False,
                       variant_practice_done=False):
    """Run one anchor through observe -> grade -> diagnose -> teach -> retry."""
    variant_attempts = 0
    _variant_practice_done = variant_practice_done
    from src.tutor.math_grader import grade as _grade
    from src.tutor.step_grader import (
        grade_steps as _grade_steps,
        first_failed_step_diagnosis as _first_fail,
    )
    from src.tutor.diagnosis import diagnose as _diagnose
    from src.tutor import teaching_objectives as _to

    if not skip_diagram:
        _diagram = _diagram_path_for(problem)
        if _diagram is not None:
            print("  Diagram page: " + str(_diagram))
            _opened = _open_diagram(problem)
            if _opened is not None:
                print("  (opened in your image viewer)")

    if not skip_dependencies:
        _continue = _show_dependencies(problem, store, learner_id)
        if not _continue:
            print("  (back — pick a different question)")
            return

    attempts = 0
    max_attempts = 3
    while attempts < max_attempts:
        attempts += 1
        submission = collect_working()
        if submission is None:
            return

        learner_lines = [s.raw_text for s in submission.steps]
        learner_text = submission.joined()

        g = _grade(learner_text, problem.expected_answer)
        print()
        print(f"  grade:  {g.kind.value}  ({g.matcher})")

        step_result = None
        try:
            step_result = _grade_steps(problem.problem_id, learner_lines)
        except Exception:
            step_result = None

        if step_result and step_result.get("total_marks", 0) > 0:
            awarded = step_result.get("awarded_marks", 0)
            total = step_result.get("total_marks", 0)
            print(f"  mark:   {awarded}/{total}")
            for s in step_result.get("steps", []):
                print(f"    {s.get('match_status','?'):12s} "
                      f"{s.get('desc','')[:55]}")
        else:
            print(f"  mark:   (no memo step scheme for {problem.problem_id})")

        diag = _diagnose(problem.skill_id, learner_text,
                         problem.expected_answer)
        misconception = diag.misconception_id
        source = "text" if misconception else None

        # Only fall back to step diagnosis if the math is actually WRONG.
        # If g.kind is 'match', the answer is right, so we don't want to
        # falsely diagnose a "missing root" just because they put it on one line.
        if (not misconception and step_result
                and step_result.get("total_marks", 0) > 0
                and g.kind.value != "match"):
            mid, desc, _ = _first_fail(
                step_result, skill_id=problem.skill_id,
                learner_line_count=len(learner_lines),
            )
            if mid:
                misconception = mid
                source = "step"

        try:
            store.save_attempt(
                session_id=session_id,
                learner_id=learner_id,
                skill_id=problem.skill_id,
                response=learner_text[:500],
                diagnosis_rule_id=diag.rule_id or "",
                misconception_id=misconception,
                hint_level=None,
                error_type=diag.error_type.value,
                question_id=problem.problem_id,
            )
        except Exception:
            pass

        _all_steps_matched = True
        _step_awarded = 0
        _step_total = 0
        if step_result and step_result.get("total_marks", 0) > 0:
            _step_awarded = step_result.get("awarded_marks", 0)
            _step_total = step_result.get("total_marks", 0)
            for s in step_result.get("steps", []):
                if s.get("match_status") != "MATCHED":
                    _all_steps_matched = False
                    break

        _step_full = (step_result and step_result.get("total_marks", 0) > 0 
                      and _step_awarded == _step_total)

        if _step_full or (g.kind.value == "match" and _all_steps_matched):
            print()
            print("=" * 60)
            print("  ✅ Correct.")
            print("=" * 60)

            # If this is the original question and they previously struggled
            if attempts > 1 or _variant_practice_done:
                print()
                print("  You mastered it. Do you want to do 5 practice questions right now, or save them as homework?")
                print("  1. Try 5 now")
                print("  2. Save as homework and move on")
                print("  3. Skip to next question")
                hw_choice = input("  > ").strip()

                if hw_choice == "1":
                    print("\n  Starting 5 practice questions...")
                    # Fire 5 variants
                    pool_path = ROOT / "data" / "processed" / "tutor" / "variant_pools" / f"{sub_id}_pool.json"
                    if pool_path.exists():
                        import json, random
                        with open(pool_path, encoding="utf-8") as f:
                            pool = json.load(f)
                        for i in range(5):
                            var_data = random.choice(pool)
                            print(f"\n  [{i+1}/5] {var_data['variant_question']}")
                            print("  (Type 'done' when finished, or press Enter to skip)")
                            ans = input("  > ").strip()
                            if ans.lower() == "done":
                                print("  ✅ Recorded.")
                            # In a full build, we would grade this. For now, we just loop to track the flow.
                    return
                elif hw_choice == "2":
                    # Log homework assignment to the store
                    store.log_event(learner_id, problem.skill_id, problem.problem_id, "HOMEWORK_ASSIGNED", f"5 variants for {sub_id}", session_id)
                    print("  ✅ Saved as homework. Moving on.")
                    return
                else:
                    print("  Skipping to next question.")
                    return
            return

        if (g.kind.value == "match" or _step_awarded > 0) and not _all_steps_matched:
            print()
            print("=" * 60)
            print(f"  Answer correct. Method incomplete — "
                  f"{_step_awarded}/{_step_total}.")
            print("=" * 60)
            print()
            print("  Tanaka: Your answer is right. Let me show you the")
            print("  presentation the examiner expects for full marks:")
            print()
            try:
                _pb = _show_playbook_if_available(problem)
            except Exception:
                pass
            # Fall through: return to loop for next subquestion
            return

        print()
        # System codes are hidden. We print the human-readable diagnosis.
        if misconception:
            # 1. Check if it's a sign flip error FIRST. Build dynamic message.
            if "SIGN_ERROR" in misconception or "SIGN_FLIP" in misconception:
                import re as _re
                l_nums = [float(n) for n in _re.findall(r"[-+]?\d*\.?\d+", learner_text) if n not in ('', '-', '+')]
                e_nums = [float(n) for n in _re.findall(r"[-+]?\d*\.?\d+", problem.expected_answer) if n not in ('', '-', '+')]

                if len(l_nums) >= 2 and len(e_nums) >= 2 and sorted([abs(x) for x in l_nums]) == sorted([abs(x) for x in e_nums]):
                    wrong = next((l for l in l_nums if l not in e_nums), l_nums[0])
                    right = next((e for e in e_nums if e not in l_nums), e_nums[0])
                    w_str = f"+{int(wrong)}" if wrong > 0 else str(int(wrong))
                    r_str = f"+{int(right)}" if right > 0 else str(int(right))
                    print(f"  Tanaka: You wrote {w_str}, but the root is {r_str}. The number is right, but the sign is flipped.")
                else:
                    print("  Tanaka: Your numbers are completely wrong. Check your working.")

            # 2. If not a sign flip, use the generic JSON message
            else:
                obj = _to.find_for(misconception)
                if obj and obj.get("learner_message"):
                    print(f"  Tanaka: {obj['learner_message']}")
                elif misconception == "M_INCOMPLETE_ROOTS":
                    print("  Tanaka: You gave one root. A quadratic has two. The second one is missing.")
                elif misconception == "M_CALCULATION_ERROR":
                    print("  Tanaka: Your method is right, but the final number is wrong. Go back to your last step and recalculate carefully.")
                elif misconception == "M_COORDINATE_SWAP":
                    print("  Tanaka: You swapped x and y. Read the question again: which value is x, and which is y?")
                elif misconception == "M_INEQ_MISSING_INTERVAL":
                    print("  Tanaka: You found one interval, but there's a second one. A quadratic inequality usually has two parts joined by 'or'.")
                elif misconception == "M_SURD_CALCULATION_ERROR":
                    print("  Tanaka: The method is right, but the final number is wrong. Did you square both sides and reject the extraneous root?")
                elif misconception == "M_COORDINATE_SIGN_FLIP":
                    print("  Tanaka: The number is right, but one sign is flipped. Check your x and y values against your working.")
                elif misconception == "M_INCOMPLETE_PAIR":
                    print("  Tanaka: You found the x values but not the y values. A simultaneous equation answer needs both.")
                elif misconception == "M_UNITS_IN_ANSWER":
                    print("  Tanaka: Your numbers are right, but you've attached units. In 'solve for x' questions, leave off the units — write just the number. The examiner marks you down for it.")
                else:
                    print(f"  Tanaka: There is a mistake here. Let's look at it together.")
            print()

            # Try the specific question playbook first
            played_book = _show_playbook_if_available(problem)

            # If no playbook, fallback to the generic objective
            if not played_book and obj is not None:
                try:
                    _to.teach(obj)
                except Exception as _e:
                    pass
        else:
            # ── FLOOR: no rule fired. Never say "no rule fired".
            # Name the failing memo step (learner-facing), then the
            # shape's misconceptions (education), then a concrete
            # floor that is not a shrug.
            _fallback_named = False

            # 1. Name the failing memo step
            _f_desc  = None
            _f_idx   = None
            _f_marks = None
            if step_result and step_result.get("steps"):
                for _i, _s in enumerate(step_result["steps"], 1):
                    if _s.get("match_status") in ("NOT_MATCHED", "UNCERTAIN"):
                        _f_desc  = (_s.get("desc") or "").strip()
                        _f_idx   = _i
                        _f_marks = _s.get("marks")
                        break
            if _f_desc:
                _fallback_named = True
                _award = ""
                if _f_marks:
                    _award = f" (worth {_f_marks} mark{'s' if _f_marks != 1 else ''})"
                print(f"  The step that did not match the memo is step {_f_idx}:")
                print(f"    {_f_desc}{_award}")

            # 2. Educate via the shape's misconception list
            try:
                from src.tutor.diagnosis import RULES as _RULES
                _shape_mids = list(_RULES.get(problem.skill_id, []))
            except Exception:
                _shape_mids = []
            _msgs = []
            for _mid in _shape_mids:
                try:
                    _obj = _to.find_for(_mid)
                    if _obj and _obj.get("learner_message"):
                        _msgs.append(_obj["learner_message"])
                except Exception:
                    pass
            if _msgs:
                _fallback_named = True
                print()
                print("  On problems of this shape, the mistakes learners make")
                print("  most often are:")
                for _m in _msgs[:4]:
                    print(f"    · {_m}")

            # 3. Absolute floor — tutor must say something specific
            if not _fallback_named:
                print("  The answer is not correct. The tutor does not yet have")
                print("  a rule for this exact step. Let us work through a similar")
                print("  problem together and name the traps as we go.")

        print()
        if attempts >= max_attempts:
            break

        # AUTOMATIC VARIANT FIRING
        if not _variant_practice_done:
            print()
            print("  " + "=" * 56)
            print("  Tanaka: Let's solidify this by trying a similar problem.")
            print("  (Type 'skip' at the input prompt to go back to the original question)")
            print("  " + "=" * 56)
            _variant_practice_done = True
            store.log_event(learner_id, problem.skill_id, problem.problem_id, "AUTO_VARIANT_SERVED", "System automatically served a variant after failure.", session_id)
        else:
            # ALWAYS auto-fire. No prompt.
            print()
            print("  " + "=" * 56)
            print("  Tanaka: Let's try another one.")
            print("  (Type 'skip' at the input prompt to stop, 'q' to quit)")
            print("  " + "=" * 56)

        if True: # Variant block
            import json as _jv
            import random as _rv
            _variant_practice_done = True

            store.log_event(learner_id, problem.skill_id, problem.problem_id, "MANUAL_VARIANT_REQUEST", "Learner voluntarily asked for a variant.", session_id)

            _parts = problem.problem_id.split("_")
            _sub_id = _parts[2][1:] if len(_parts) >= 3 else problem.problem_id
            _pool_path = ROOT / "data" / "processed" / "tutor" / "variant_pools" / f"{_sub_id}_pool.json"

            if _pool_path.exists():
                with open(_pool_path, encoding="utf-8") as _f:
                    _pool = _jv.load(_f)

                _variant_attempts = 0
                while True:
                    _variant_attempts += 1
                    _var = _rv.choice(_pool)

                    print()
                    print("=" * 60)
                    print("  VARIANT PRACTICE  (attempt " + str(_variant_attempts) + ")")
                    print("=" * 60)
                    print("  " + _var["variant_question"])
                    print()
                    print("  Show your working. One line at a time.")
                    print("  - Type 'done' when finished")
                    print("  - Type 'v' for a new variant, 'skip' to go back, 'q' to quit")
                    print()

                    _var_lines = []
                    while True:
