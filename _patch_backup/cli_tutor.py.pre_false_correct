                        print("  ✅ Correct! You mastered the variant.")
                        print("  Now let's go back to the original question.")
                        print()
                        break
                    else:
                        print()
                        print("  grade:  no_match")
                        print()
                        from src.tutor.diagnosis import diagnose as _vd
