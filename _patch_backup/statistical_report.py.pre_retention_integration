# ─── TOPIC MAP (skill_id → topic code) ──────────────────────────────────────
TOPIC_MAP = {
    "algebra": "ALG", "sequences": "SEQ", "functions": "FUNC",
    "calculus": "CALC", "finance": "FIN", "probability": "PROB",
    "statistics": "STAT", "analytical_geom": "AGEO",
