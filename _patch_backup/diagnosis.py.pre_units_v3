    )


# ─── COVERAGE FIX: Add rules for uncovered errors ────────────────────────────
def _coord_swap(nr, expected, *args):
    """x = A, y = B  vs  x = B, y = A  (the pair was swapped)."""
    def _pair(s):
        import re as _r
        s = str(s).lower().replace(" ", "")
        xm = _r.search(r"x=(-?\d+(?:\.\d+)?)", s)
        ym = _r.search(r"y=(-?\d+(?:\.\d+)?)", s)
        if xm and ym:
            return (float(xm.group(1)), float(ym.group(1)))
        return None
    pa = _pair(nr)
    pb = _pair(expected)
    if pa is None or pb is None:
        return False
    return pa[0] == pb[1] and pa[1] == pb[0] and pa != pb


def _calc_error_generic(nr, expected, *args):
    """Same structure, at least one number wrong (not a swap, not a sign flip)."""
    import re as _r
    # Extract all numbers
    l_nums = [float(n) for n in _r.findall(r"-?\d+(?:\.\d+)?", str(nr))]
    e_nums = [float(n) for n in _r.findall(r"-?\d+(?:\.\d+)?", str(expected))]
    if not l_nums or not e_nums:
        return False
    # If the multiset of absolute values differs, it's a calculation error
    l_abs = sorted([abs(x) for x in l_nums])
    e_abs = sorted([abs(x) for x in e_nums])
    if l_abs != e_abs:
        # But not if it's empty or gibberish
        return 1 <= len(l_nums) <= 5 and 1 <= len(e_nums) <= 5
    return False


def _ineq_missing_interval(nr, expected, *args):
    """Wrote 'x < 0' but expected 'x < 0 or x > 3' (missed the second interval)."""
    nr_s = str(nr).lower()
    ex_s = str(expected).lower()
    # Expected has 'or' / 'and' (two intervals), learner doesn't
    ex_has_2 = ("or" in ex_s) or ("and" in ex_s)
    nr_has_2 = ("or" in nr_s) or ("and" in nr_s)
    return ex_has_2 and not nr_has_2


# Register these in the appropriate skills
if "algebra.simultaneous.solve" in RULES:
    RULES["algebra.simultaneous.solve"].insert(0, 
        ("M_COORDINATE_SWAP", ErrorType.CONCEPTUAL, "Swapped x and y.", _coord_swap))
    RULES["algebra.simultaneous.solve"].append(
        ("M_CALCULATION_ERROR", ErrorType.PROCEDURAL, "Wrong number.", _calc_error_generic))

if "algebra.quadratic.solve" in RULES:
    RULES["algebra.quadratic.solve"].append(
        ("M_CALCULATION_ERROR", ErrorType.PROCEDURAL, "Wrong number.", _calc_error_generic))

if "algebra.quadratic.inequality" in RULES:
    RULES["algebra.quadratic.inequality"].insert(0,
        ("M_INEQ_MISSING_INTERVAL", ErrorType.PROCEDURAL, "Missing interval.", _ineq_missing_interval))
    RULES["algebra.quadratic.inequality"].append(
        ("M_CALCULATION_ERROR", ErrorType.PROCEDURAL, "Wrong number.", _calc_error_generic))


# ─── SURD + SIMULTANEOUS COVERAGE RULES ─────────────────────────────────────
def _surd_single_num_wrong(nr, expected, *args):
    """Surd question: learner wrote a single number/fraction that doesn't match."""
    import re as _r
    from fractions import Fraction

    def _parse(s):
        s = str(s).lower()
        # strip x=, y=, =, spaces
        s = _r.sub(r"\bx\s*=\s*", "", s)
        s = _r.sub(r"\by\s*=\s*", "", s)
        s = s.replace("=", "").strip()
        # if the string still has multiple parts, it's not a single-number answer
        if _r.search(r"\bor\b|\band\b|,", s):
            return None
        try:
            return Fraction(s)
        except (ValueError, ZeroDivisionError, TypeError):
            try:
                return Fraction(float(s))
            except (ValueError, TypeError):
                return None

    l = _parse(nr)
    e = _parse(expected)
    return l is not None and e is not None and l != e

def _coord_sign_flip(nr, expected, *args):
    """Simultaneous: x = -3, y = 1 vs x = 3, y = 1 (some signs flipped)."""
    import re as _r
    def _pairs(s):
        s = str(s).lower().replace(" ", "")
        pairs = []
        current = {}
        for x_v, y_v in _r.findall(r"x=(-?\d+(?:\.\d+)?)|y=(-?\d+(?:\.\d+)?)", s):
            if x_v: current["x"] = float(x_v)
            if y_v:
                current["y"] = float(y_v)
                if "x" in current: pairs.append((current["x"], current["y"]))
                current = {}
        return pairs
    lp = _pairs(nr)
    ep = _pairs(expected)
    if not lp or not ep or len(lp) != len(ep):
        return False
    # Same absolute values but different signs
    l_abs = sorted([(abs(a), abs(b)) for a, b in lp])
    e_abs = sorted([(abs(a), abs(b)) for a, b in ep])
    return l_abs == e_abs and lp != ep


def _coord_missing_y(nr, expected, *args):
    """Simultaneous: learner wrote only x values, forgot y."""
    import re as _r
    nr_s = str(nr).lower().replace(" ", "")
    ex_s = str(expected).lower().replace(" ", "")
    return "x=" in nr_s and "y=" not in nr_s and "y=" in ex_s


if "algebra.surd.solve" in RULES:
    RULES["algebra.surd.solve"].insert(0,
        ("M_SURD_CALCULATION_ERROR", ErrorType.PROCEDURAL, "Wrong number from surd equation.", _surd_single_num_wrong))

if "algebra.simultaneous.solve" in RULES:
    RULES["algebra.simultaneous.solve"].insert(0,
        ("M_COORDINATE_SIGN_FLIP", ErrorType.CONCEPTUAL, "Sign flipped on one coordinate.", _coord_sign_flip))
    RULES["algebra.simultaneous.solve"].insert(1,
        ("M_INCOMPLETE_PAIR", ErrorType.PROCEDURAL, "Missing y-values.", _coord_missing_y))


def _units_in_answer(nr, expected, *args):
    """Learner wrote correct numbers but attached units (m, cm, kg, etc.)."""
    import re as _r
    # nr is already normalized (spaces stripped) — "x=-5morx=2m"
    # Use a lookahead for common separators instead of \b (fails when m is followed by 'or')
    unit_re = r"(\d+(?:\.\d+)?)\s*(?:m|cm|km|mm|kg|g|s|min|h|°|%|R|\$)(?=or|and|,|;|$)"
    stripped = _r.sub(unit_re, r"\1", str(nr), flags=_r.IGNORECASE)
    s_learner = stripped.strip().lower().replace(" ", "")
    s_orig = str(nr).strip().lower().replace(" ", "")
    s_expected = str(expected).strip().lower().replace(" ", "")
    # Only fire if stripping changed something AND result matches expected
    return s_learner != s_orig and s_learner == s_expected


# ─── REGISTER: M_UNITS_IN_ANSWER ─────────────────────────────────────────────
if "algebra.quadratic.solve" in RULES:
    _already = any(r[0] == "M_UNITS_IN_ANSWER" for r in RULES["algebra.quadratic.solve"])
    if not _already:
        RULES["algebra.quadratic.solve"].insert(0,
            ("M_UNITS_IN_ANSWER", ErrorType.PROCEDURAL, "Correct numbers, but wrote units.", _units_in_answer))
