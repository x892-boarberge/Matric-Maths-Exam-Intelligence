def _declared_roots(text):
    """Extract every root the learner declared.

    Handles three forms:
        x = 5 or x = 3   -> {5, 3}
        x = 5 or 3       -> {5, 3}
        x = 5, 3         -> {5, 3}
    """
    if not isinstance(text, str):
        return set()
    out = set()

    # 1. Every "x = N" declaration
    for m in re.finditer(r"(?<![0-9a-z])x\s*=\s*(-?\d+(?:\.\d+)?)",
                         text, re.IGNORECASE):
        try:
            out.add(float(m.group(1)))
        except ValueError:
            pass

    # 2. Every bare number after "or", "and", or "," in a root-like
    #    context. Whitespace is optional — _norm collapses spaces
    #    around minus signs, so "or -2" becomes "or-2" before this
    #    runs.
    for m in re.finditer(r"\b(?:or|and|,)\s*(-?\d+(?:\.\d+)?)",
                         text, re.IGNORECASE):
        try:
            out.add(float(m.group(1)))
        except ValueError:
            pass

    return out


def diagnose(skill_id: str, learner_response: str, expected_answer: str,
             prompt: str = "") -> DiagnosisResult:
    nr = _norm(learner_response)

    if _is_correct(learner_response, expected_answer):
        return DiagnosisResult(
            error_type=ErrorType.NONE,
            misconception_id=None,
            confidence=1.0,
            rule_id="D_CORRECT",
            explanation="Response matches expected answer after normalisation.",
        )

    # Extra safety net: if the learner's declared roots equal the
    # expected roots as sets, treat the response as correct even when
    # the working text includes additional content that the matcher
    # cannot reduce. Prevents the N08 fallback from firing on noise.
    _lr = _declared_roots(learner_response)
    _er = _declared_roots(expected_answer)
    if _lr and _er and _lr == _er:
        # Exception 1: if the learner joined two roots with "and" instead
        # of "or", the roots match but the connector is wrong.
        _has_and_between_roots = bool(re.search(
            r"\d\s+and\s+[-x\d]",
            learner_response, re.IGNORECASE,
        ))
        # Exception 2: general-solution form mismatch. If either side
        # carries a general-solution marker (+ k.360, + 360k, k in Z)
        # and the other does not, the roots match but the form differs.
        # Do not short-circuit as "correct".
        _gen_re = r"\+\s*k\s*\.?\s*\d|\+\s*\d+\s*k|k\s*\u2208|k\s*in\s*Z"
        _learner_general = bool(re.search(_gen_re, learner_response, re.IGNORECASE))
        _expected_general = bool(re.search(_gen_re, expected_answer, re.IGNORECASE))
        _has_general_marker = _learner_general or _expected_general
        _has_fraction = "/" in str(learner_response) or "/" in str(expected_answer)
        if (not _has_and_between_roots and not _has_general_marker 
            and not _has_fraction
            and not ("y=" in expected_answer.replace(" ","") or "y=" in nr.replace(" ",""))):
            return DiagnosisResult(
                error_type=ErrorType.NONE,
                misconception_id=None,
                confidence=0.95,
                rule_id="D_CORRECT_ROOTS_MATCH",
                explanation="Learner declared the same roots as expected, ignoring working text.",
            )

    for mid, etype, expl, pred in RULES.get(skill_id, []):
        try:
            fired = pred(nr, expected_answer, prompt)
        except TypeError:
            # Backwards-compatible: predicate only takes two arguments
            fired = pred(nr, expected_answer)
        if fired:
            return DiagnosisResult(
                error_type=etype,
                misconception_id=mid,
                confidence=0.85,
                rule_id=f"D_{mid}",
                explanation=expl,
            )

    # Layer 2 — trigger-based fallback (N08 v2)
    topic_hint = _topic_from_skill(skill_id)
    for rule in _load_trigger_library():
        if topic_hint and rule["topic"] not in (topic_hint, "GEN"):
            continue
        if rule["pattern"].search(nr):
            return DiagnosisResult(
                error_type=_error_type_for_class(rule["error_class"]),
                misconception_id=rule["mid"],
                confidence=0.65,
                rule_id=f"D_TRIGGER_{rule['mid']}",
                explanation=rule["description"],
            )

    return DiagnosisResult(
        error_type=ErrorType.UNKNOWN,
        misconception_id=None,
        confidence=0.3,
        rule_id="D_UNKNOWN",
        explanation="No matching correct or misconception pattern after normalisation.",
    )


def reachable_misconception_ids() -> set[str]:
    ids = set()
    for rules in RULES.values():
        for mid, *_ in rules:
            ids.add(mid)
    for rule in _load_trigger_library():
        ids.add(rule["mid"])
    return ids

# ══════════════════════════════════════════════════════════════════════
# TRIGONOMETRY — diagnostic rules
# Appended at the end. RULES, _norm, _declared_roots already exist above.
# ══════════════════════════════════════════════════════════════════════

_TRIG_FUNCS = ("sin", "cos", "tan")


def _extract_trig_func(text):
    if not isinstance(text, str):
        return None
    for f in _TRIG_FUNCS:
        if re.search(r"\b" + f + r"\b", text, re.IGNORECASE):
            return f
    return None


def _trig_reduction_sign(nr, expected, prompt=""):
    """Learner lost the minus sign in a reduction."""
    if not isinstance(expected, str) or not isinstance(nr, str):
        return False
    e = expected.strip()
    if not e.startswith("-"):
        return False
    positive_form = e[1:].strip()
    if not positive_form:
        return False
    fn_e = _extract_trig_func(positive_form)
    fn_n = _extract_trig_func(nr)
    if fn_e and fn_n and fn_e == fn_n:
        return not re.search(r"-\s*" + fn_n, nr, re.IGNORECASE)
    return False


def _trig_reduction_cofunction(nr, expected, prompt=""):
    """Learner used the wrong co-function (sin<->cos)."""
    if not isinstance(expected, str) or not isinstance(nr, str):
        return False
    fn_e = _extract_trig_func(expected)
    fn_n = _extract_trig_func(nr)
    if not fn_e or not fn_n or fn_e == fn_n:
        return False
    return {fn_e, fn_n} == {"sin", "cos"}


def _trig_identity_linear(nr, expected, prompt=""):
    """sin 2x written as 2 sin x, or cos 2x written as 2 cos x."""
    if not isinstance(nr, str):
        return False
    low = nr.lower().replace(" ", "")
    return bool(re.search(r"sin2[a-z]?=2sin[a-z]\b", low)) or \
           bool(re.search(r"cos2[a-z]?=2cos[a-z]\b", low))


def _trig_eq_divide_by_ratio(nr, expected, prompt=""):
    """Divided both sides by a trig ratio, losing roots."""
    if not isinstance(nr, str):
        return False
    low = nr.lower().replace(" ", "")
    return bool(re.search(r"/(sin|cos|tan)[a-z]", low))


def _trig_eq_missing_solution(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    want = _declared_roots(expected)
    got = _declared_roots(nr)
    if not want or not got:
        return False
    return len(got) < len(want) and got.issubset(want)


def _trig_eq_general_when_interval(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(prompt, str):
        return False
    if "interval" not in prompt.lower() and "in the" not in prompt.lower():
        return False
    return bool(re.search(r"\+\s*k\s*\.?\s*360|\+\s*360k|k\s*\u2208", nr, re.IGNORECASE))


def _trig_period_domain_confusion(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    e = expected.strip()
    if not re.match(r"^\d+\s*\u00b0?$", e):
        return False
    return bool(re.search(r"\[|\]|\(|\)|\bin\b|\binterval\b", nr)) or "domain" in nr.lower()


def _trig_period_coefficient(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    try:
        e_val = float(re.sub(r"[^\d.]", "", expected))
    except Exception:
        return False
    m = re.search(r"\b(\d+)\s*\u00b0?\b", nr)
    if not m:
        return False
    got = float(m.group(1))
    return got != e_val and got in (180.0, 360.0)


def _trig_graph_value_label_swapped(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    if not re.search(r"\bx\s*=", expected):
        return False
    return bool(re.search(r"\by\s*=", nr)) and not re.search(r"\bx\s*=", nr)


def _trig_compound_wrong_form(nr, expected, prompt=""):
    """Learner used cos-expansion where sin-expansion was needed.

    Both sin(A+B) and cos(A-B) contain two sin and two cos terms, so
    counting does not work. Detect the first product pattern instead.
    """
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    low_e = expected.lower().replace(" ", "")
    low_n = nr.lower().replace(" ", "")
    # Expected pattern: sin*cos + cos*sin
    e_sin_first = bool(re.search(r"sin[abc]?\*?cos[abc]?", low_e))
    # Learner pattern: cos*cos +/- sin*sin (the cos-expansion)
    n_cos_first = bool(re.search(r"cos[abc]?\*?cos[abc]?", low_n))
    if e_sin_first and n_cos_first:
        return True
    return False


def _trig_3d_wrong_ratio(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    fn_e = _extract_trig_func(expected)
    fn_n = _extract_trig_func(nr)
    if not fn_e or not fn_n:
        return False
    return fn_e != fn_n and {fn_e, fn_n}.issubset({"sin", "cos", "tan"})


def _trig_unitcircle_sign(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    def _nums(s):
        return re.findall(r"-?\d+(?:\.\d+)?", s)
    e_nums = _nums(expected)
    n_nums = _nums(nr)
    if not e_nums or not n_nums:
        return False
    try:
        e_mag = {abs(float(x)) for x in e_nums}
        n_mag = {abs(float(x)) for x in n_nums}
        e_signed = {float(x) for x in e_nums}
        n_signed = {float(x) for x in n_nums}
    except ValueError:
        return False
    if e_mag != n_mag:
        return False
    return e_signed != n_signed


def _trig_max_angle_not_ratio(nr, expected, prompt=""):
    if not isinstance(nr, str):
        return False
    if re.search(r"\bx\s*=\s*-?\d+\s*\u00b0?", nr):
        if not re.search(r"\b(sin|cos|tan)\s*[a-z]?\s*=", nr, re.IGNORECASE):
            return True
    return False


def _looks_like_general_solution(text):
    """True if the text expresses a periodic/general solution.

    Covers SA-matric notation:
      + 360k   + 360 k   + k·360   + k.360   + 2kπ   + kπ
      + 180n   + n·180   + 2nπ    + k*360
    """
    if not text:
        return False
    t = str(text).lower()
    t = t.replace("\u00b0", "").replace("\u00b7", ".").replace("\u03c0", "pi")
    # remove the "or" separator to avoid false hits on words
    patterns = [
        r"[+\-]\s*\d*\s*[kn]\b",                    # + 360k, + k, + 2n
        r"[+\-]\s*[kn]\s*\.?\s*\d+",               # + k.360, + n.180
        r"[+\-]\s*\d*\s*[kn]\s*pi",                 # + 2kpi, + kpi
        r"\b[kn]\s*\.?\s*\d+\s*(?:pi)?",             # k.360, n.180
    ]
    for p in patterns:
        if re.search(p, t):
            return True
    return False


def _trig_general_solution_incomplete(nr, expected, prompt=""):
    if not isinstance(nr, str) or not isinstance(expected, str):
        return False
    if not _looks_like_general_solution(expected):
        return False
    return not _looks_like_general_solution(nr)


