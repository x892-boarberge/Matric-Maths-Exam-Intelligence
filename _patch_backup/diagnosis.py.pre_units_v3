# ─── BULLETPROOF OVERRIDES (Appended at end) ────────────────────────────────
def _bulletproof_sign_flip(nr, expected, prompt=""):
    l_roots = _extract_roots(nr)
    e_roots = _extract_roots(expected)
    if len(l_roots) != len(e_roots) or len(l_roots) < 2:
        return False
    l_abs = sorted([abs(x) for x in l_roots])
    e_abs = sorted([abs(x) for x in e_roots])
    return l_abs == e_abs and sorted(l_roots) != sorted(e_roots)

# Override the quadratic rules with the bulletproof one
if "algebra.quadratic.solve" in RULES:
    for i, rule in enumerate(RULES["algebra.quadratic.solve"]):
        if rule[0] == "M_SIGN_ERROR_READING_ROOT":
            RULES["algebra.quadratic.solve"][i] = (
                "M_SIGN_ERROR_READING_ROOT", 
                ErrorType.CONCEPTUAL, 
                "Sign flipped on a root.", 
                _bulletproof_sign_flip
            )

# Appended missing structural rules
if "algebra.surd.solve" in RULES:
    RULES["algebra.surd.solve"].append(
        ("M_CALCULATION_ERROR", ErrorType.PROCEDURAL, "Wrong number calculated.", lambda nr, ex: len(_extract_roots(nr)) == 1 and len(_extract_roots(ex)) == 1 and _extract_roots(nr) != _extract_roots(ex))
    )

if "algebra.exponential.solve" in RULES:
    RULES["algebra.exponential.solve"].append(
        ("M_CALCULATION_ERROR", ErrorType.PROCEDURAL, "Wrong number calculated.", lambda nr, ex: len(_extract_roots(nr)) >= 1 and len(_extract_roots(ex)) >= 1 and set(_extract_roots(nr)) != set(_extract_roots(ex)))
    )


# ─── FINAL BULLETPROOF OVERRIDE ─────────────────────────────────────────────
def _final_sign_flip(nr, expected, *args):
    l_roots = _extract_roots(nr)
    e_roots = _extract_roots(expected)
    if len(l_roots) != len(e_roots) or len(l_roots) < 2: return False
    l_abs = sorted([abs(x) for x in l_roots])
    e_abs = sorted([abs(x) for x in e_roots])
    return l_abs == e_abs and sorted(l_roots) != sorted(e_roots)

if "algebra.quadratic.solve" in RULES:
    for i, r in enumerate(RULES["algebra.quadratic.solve"]):
        if "SIGN_ERROR" in r[0]:
            RULES["algebra.quadratic.solve"][i] = ("M_SIGN_ERROR_READING_ROOT", ErrorType.CONCEPTUAL, "Sign flipped", _final_sign_flip)


# ─── TRIG BULLETPROOF OVERRIDES ─────────────────────────────────────────────
def _bulletproof_trig_sign(nr, expected, *args):
    nr = nr.replace(" ", "").lower()
    expected = expected.replace(" ", "").lower()
    # If the function matches but the negative sign is missing/present
    for func in ["cos", "sin", "tan"]:
        if func in nr and func in expected:
            return nr.startswith("-") != expected.startswith("-")
    return False

def _insufficient_proof_working(nr, expected, *args):
    # If a student types less than 15 characters for a proof, they didn't write the steps
    return len(nr.strip()) < 15

# Force the Trig Reduction override
if "trig.reduction.simplify" in RULES:
    # Clear existing and add our bulletproof one
    RULES["trig.reduction.simplify"] = [
        ("M_TRIG_RED_SIGN", ErrorType.CONCEPTUAL, "Sign error in reduction.", _bulletproof_trig_sign)
    ]

# Force the Trig Identity Prove override
if "trig.identity.prove" in RULES:
    # Add a rule to catch lazy answers like "I proved it"
    RULES["trig.identity.prove"].insert(0, 
        ("M_INSUFFICIENT_WORKING", ErrorType.PROCEDURAL, "No working shown.", _insufficient_proof_working)
    )


