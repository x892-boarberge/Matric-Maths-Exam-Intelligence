def render_html(md_text, name):
    """Wrap the markdown in a friendly, shareable HTML template."""
    # Very light markdown → HTML conversion (headers, bold, italic, lists, tables)
    import re
    lines = md_text.split("\n")
    html_body = []
    in_list = False

    for line in lines:
        s = line.rstrip()

        # Close list if we hit a non-list line
        if in_list and not s.startswith("- "):
            html_body.append("</ul>")
            in_list = False

        if s.startswith("# "):
            html_body.append(f'<h1>{s[2:]}</h1>')
        elif s.startswith("## "):
            html_body.append(f'<h2>{s[3:]}</h2>')
        elif s.startswith("### "):
            html_body.append(f'<h3>{s[4:]}</h3>')
        elif s.startswith("*") and s.endswith("*") and not s.startswith("**"):
            html_body.append(f'<p class="meta">{s.strip("*")}</p>')
        elif s.startswith("- "):
            if not in_list:
                html_body.append("<ul>")
                in_list = True
            item = s[2:]
            item = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", item)
            item = re.sub(r"(?<!\*)\*([^*]+?)\*(?!\*)", r"<em>\1</em>", item)
            item = re.sub(r"`([^`]+)`", r"<code>\1</code>", item)
            html_body.append(f"<li>{item}</li>")
        elif s == "":
            html_body.append("")
        elif s == "---":
            html_body.append("<hr>")
        else:
            body = s
            body = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", body)
            body = re.sub(r"(?<!\*)\*([^*]+?)\*(?!\*)", r"<em>\1</em>", body)
            body = re.sub(r"`([^`]+)`", r"<code>\1</code>", body)
            html_body.append(f"<p>{body}</p>")

    if in_list:
        html_body.append("</ul>")

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>A note from Tanaka about {name}</title>
<style>
  body {{
    font-family: Georgia, 'Times New Roman', serif;
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 24px;
    background: #fafaf7;
    color: #2b2b2b;
    line-height: 1.7;
    font-size: 17px;
  }}
  h1 {{
    font-size: 28px;
    border-bottom: 2px solid #2b2b2b;
    padding-bottom: 12px;
    margin-bottom: 8px;
    color: #1a1a1a;
  }}
  h2 {{
    font-size: 20px;
    margin-top: 32px;
    margin-bottom: 12px;
    color: #1a1a1a;
    border-bottom: 1px solid #d8d4c8;
    padding-bottom: 6px;
  }}
  h3 {{ font-size: 17px; margin-top: 24px; }}
  p {{ margin: 12px 0; }}
  ul {{ margin: 12px 0; padding-left: 24px; }}
  li {{ margin: 8px 0; }}
  code {{
    background: #efece2;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
    font-size: 0.92em;
    color: #4a4a4a;
  }}
  .meta {{
    color: #8a8478;
    font-style: italic;
    font-size: 15px;
    margin-bottom: 32px;
  }}
  strong {{ color: #1a1a1a; }}
  hr {{
    border: none;
    border-top: 1px solid #d8d4c8;
    margin: 32px 0;
  }}
  /* Human-tutor recommendation — visually set apart, never aggressive */
  h2:has(+ p:empty) {{}}
  a {{ color: #6b4a1f; text-decoration: underline; }}
  a:hover {{ color: #4a3418; }}
  @media print {{
    body {{ background: white; padding: 0; }}
  }}
</style>
</head>
<body>
{chr(10).join(html_body)}
</body>
</html>
"""


def main():
    import sys
    learner = sys.argv[1] if len(sys.argv) > 1 else "tanaka"
    days = 7
    if len(sys.argv) > 2:
        try:
            days = int(sys.argv[2])
        except ValueError:
            pass

    md = build_parent_letter(learner, days)
    html = render_html(md, _display_name(learner))

    print(md)

    REPORTS.mkdir(parents=True, exist_ok=True)
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    md_path = REPORTS / f"{learner}_parent_{ts}.md"
    html_path = REPORTS / f"{learner}_parent_{ts}.html"
    md_path.write_text(md, encoding="utf-8")
    html_path.write_text(html, encoding="utf-8")

    print(f"\n\n📄 Email body (markdown): {md_path}")
    print(f"🌐 Shareable letter (HTML): {html_path}")


if __name__ == "__main__":
    main()
