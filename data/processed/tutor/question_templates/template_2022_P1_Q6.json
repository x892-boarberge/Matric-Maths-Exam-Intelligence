      "n": "6.1",
      "prompt_template": "R12 000 invested at m% p.a. compounded quarterly for 24 months. Value = R13 459. Find m.",
      "ranges": {
        "shift": [
          -1,
          1,
          2,
          3,
          4,
          5
        ]
      },
      "marks": 4,
      "skill_id": "finance.compound",
      "expected_fn": "m = 5.78%",
      "steps": [
        "A = P(1 + i)^n, i = m/400, n = 8.",
        "13459 = 12000(1 + m/400)^8",
        "(1 + m/400)^8 = 1.1216",
        "1 + m/400 = (1.1216)^(1/8) = 1.01444",
        "m/400 = 0.01444, m = 5.78%."
      ]
