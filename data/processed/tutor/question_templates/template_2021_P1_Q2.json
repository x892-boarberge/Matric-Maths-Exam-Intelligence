{
  "stem": "Given the geometric series: x + {a} + {b} + ...",
  "subquestions": [
    {
      "n": "2.1",
      "prompt_template": "Calculate the value of x.",
      "ranges": {
        "a": [
          77,
          78,
          79,
          80
        ],
        "b": [
          69,
          70,
          71,
          72
        ]
      },
      "marks": 2,
      "skill_id": "sequences.gp",
      "expected_fn": "x = {x_ans}",
      "steps": [
        "r = {b}/{a}",
        "x*r = {a}, so x = {a}/r = {x_ans}."
      ]
    },
    {
      "n": "2.2",
      "prompt_template": "Show that S_n = {S_a}(1 - ({r_disp})^n).",
      "ranges": {
        "shift": [
          1,
          2,
          3
        ]
      },
      "marks": 2,
      "skill_id": "sequences.gp",
      "expected_fn": "S_n = {S_a}(1 - ({r_disp})^n)",
      "steps": [
        "S_n = a(1 - r^n)/(1 - r)",
        "a = x, r = {r_disp}.",
        "S_n = x(1 - r^n)/(1 - {r_disp}).",
        "Simplify."
      ]
    },
    {
      "n": "2.3",
      "prompt_template": "Hence, calculate the sum to infinity.",
      "ranges": {
        "shift": [
          -1,
          1,
          2,
          3,
          4,
          5
        ]
      },
      "marks": 2,
      "skill_id": "sequences.gp",
      "expected_fn": "S_inf = {S_inf}",
      "steps": [
        "S_inf = a/(1 - r).",
        "S_inf = {S_inf}."
      ]
    }
  ],
  "source": {
    "year": 2021,
    "paper": "P1",
    "qnum": "2"
  }
}